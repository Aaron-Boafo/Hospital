# Copy to .env and fill in the values

NODE_ENV="development"
PORT=1000

# Postgres connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/hospital"
# Optional: separate test database (used when NODE_ENV="test")
TEST_DB="postgresql://postgres:password@localhost:5432/hospital_test"

# --- JWT session ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_ISSUER="hms-backend"
JWT_AUDIENCE="hms-frontend"
JWT_EXPIRES_IN="1d"
JWT_ALGORITHM="HS256"

# --- Firebase Admin (service account JSON from Firebase console) ---
FIREBASE_SERVICE_ACCOUNT=""

# --- CORS (comma-separated origins, e.g. "http://localhost:5173,http://localhost:5174") ---
CORS_ORIGINS=""

# --- Logging ---
LOG_LEVEL="debug"
LOG_DIR="logs"
